# macOS and editor files
.DS_Store
**/.DS_Store
*.swp
*.swo

# Python environments, caches, and generated bytecode
**/.venv/
**/.cache/
**/__pycache__/
*.py[cod]
**/.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local R reproduction environment and installed packages
**/reproduction/r_environment/

# Raw, intermediate, and processed datasets
# Keep manifests and documentation outside these directories versionable.
**/data/raw/
**/data/interim/
**/data/processed/

# Temporary/staging outputs; final results remain versionable.
**/results/.tmp*/
**/results/**/.tmp*/
**/results/tmp/
**/results/**/tmp/
**/results/staging/
**/results/**/staging/
**/results/scratch/
**/results/**/scratch/

# Local logs and secrets
*.log
.env
.env.*
!.env.example

data-temp/